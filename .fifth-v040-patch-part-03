+
+    private void validateScript() {
+        if (editor == null) return;
+        String s = editor.getText();
+        int depth = 0;
+        boolean bad = false;
+        for (char c : s.toCharArray()) {
+            if (c == '{') depth++;
+            if (c == '}') depth--;
+            if (depth < 0) bad = true;
+        }
