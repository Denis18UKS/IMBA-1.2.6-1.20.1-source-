+        rebuildPreserving();
+    }
+
+    private void rebuildPreserving() {
+        if (client == null || rebuilding) return;
+        rebuilding = true;
+        clearAndInit();
+        rebuilding = false;
+    }
+
+    public void updateNpcLibrary(List<NpcInfo> rows) {
+        List<NpcInfo> fresh = rows == null ? List.of() : List.copyOf(rows);
+        if (fresh.equals(npcLibrary)) return;
+        npcLibrary = fresh;
+        if (!selectedNpc.isBlank() && npcLibrary.stream().noneMatch(n -> n.id.equals(selectedNpc))) selectedNpc = "";
+        status = "Автообнаружено NPC: " + npcLibrary.size();
+        rebuildPreserving();
+    }
+
+    private void requestNpcLibrary() {
