+        }
+        return out;
+    }
+
+    private void insertTemplate() {
+        if (editor == null) {
+            narrowView = 0;
+            rebuildPreserving();
+            status = "Открыл редактор кода. Повтори вставку шаблона.";
+            return;
+        }
+        String npc = selectedNpc.isBlank() ? "npc_id" : selectedNpc;
+        String scriptName = name == null || name.getText().isBlank() ? "main" : name.getText();
